{
  "name": "@oicl/connector-diagram",
  "version": "0.1.0",
  "description": "Canvas-based pipe/connector diagram renderer for OpenBridge",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ocean-Industries-Concept-Lab/openbridge-webcomponents.git",
    "directory": "packages/connector-diagram"
  },
  "homepage": "https://www.openbridge.no",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.txt",
    "LICENSE-AGPL.txt",
    "LICENSE-APACHE.txt"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "example": "vite serve example --open",
    "test": "vitest run --project=unit",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build",
    "test:unit": "vitest --project=unit",
    "test-storybook": "vitest --project=storybook",
    "test-storybook:watch": "vitest --project=storybook --watch",
    "update-snapshots": "vitest run --project=storybook --update",
    "clean": "rm -rf node_modules dist storybook-static"
  },
  "devDependencies": {
    "@oicl/openbridge-webcomponents": "*",
    "@playwright/test": "1.60.0",
    "@storybook/addon-vitest": "10.3.2",
    "@storybook/html": "10.3.2",
    "@storybook/html-vite": "10.3.2",
    "@types/node": "^20.0.0",
    "@vitest/browser-playwright": "^4.0.18",
    "playwright": "^1.60.0",
    "storybook": "10.3.2",
    "storybook-addon-vis": "3.0.1",
    "typescript": "^5.5.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "storybook": "$storybook"
  }
}
