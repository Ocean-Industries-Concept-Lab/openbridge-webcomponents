{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSources": false,
    "plugins": []
  },
  "include": [
    "script/**/*.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "*.config.ts",
    "new-component.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
