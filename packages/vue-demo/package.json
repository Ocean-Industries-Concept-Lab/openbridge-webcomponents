{
  "name": "vue-demo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf node_modules dist",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false && vue-tsc --noEmit -p tsconfig.node.json --composite false && vue-tsc --noEmit -p e2e/tsconfig.json",
    "check": "npm run format:check && npm run lint:check",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@oicl/openbridge-webcomponents": "*",
    "@oicl/openbridge-webcomponents-vue": "*",
    "@types/leaflet": "^1.9.22",
    "@vueuse/core": "^15.0.0",
    "@vueuse/firebase": "^15.0.0",
    "chart.js": "^4.6.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-gradient": "^0.8.0",
    "firebase": "^13.3.0",
    "hls.js": "^1.7.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.17.0",
    "pinia": "^4.1.0",
    "pmtiles": "^4.5.0",
    "proj4": "^2.22.0",
    "proj4leaflet": "^1.0.2",
    "uplot": "^1.6.32",
    "vue": "^3.5.45",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/devtools-api": "^8.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "firebase-tools": "^15.35.0",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "3.3.11"
  }
}
